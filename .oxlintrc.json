{
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "jsx-a11y",
    "oxc"
  ],
  "jsPlugins": ["./scripts/lint/no-loose-text.ts"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/mockServiceWorker.js",
    "*.gen.ts",
    "src/components/ui/**/*.tsx",
    "containers/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    // `import { type X } from 'y'` compiles to `import {} from 'y'` under
    // verbatimModuleSyntax — a side-effect import that keeps y's whole graph
    // in the client bundle. Only the top-level `import type` form is erased,
    // so the boundary rule below (allowTypeImports) is only sound if the
    // inline form cannot exist (#1445).
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-condition": "warn",
    "eslint/no-console": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "react/rules-of-hooks": "error",
    // oxlint 1.80 promoted the React Compiler rules into `correctness`, which added
    // 87 errors on unchanged source (#1404). Downgraded to `warn` so the findings
    // stay visible without gating CI. #1417 tracks working them down: restore a rule
    // to "error" and delete its line here once its count reaches zero.
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    // 1.80 also stopped defaulting these ignore patterns, so idiomatic `_`
    // throwaways and omit-a-key rest destructuring began erroring.
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "openstory/no-loose-text": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "#db-client",
            "message": "Only db/scoped.ts and auth/config.ts may import #db-client"
          },
          {
            "name": "@/lib/db/scoped",
            "importNames": ["createScopedDb"],
            "message": "createScopedDb only allowed in middleware.ts, workflow/base-workflow.ts, and authorized route handlers. Use context.scopedDb."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "*.gen.ts", "*.stories.tsx"],
      "rules": {
        "typescript/no-explicit-any": "warn",
        "typescript/no-floating-promises": "off",
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "src/lib/observability/logger.ts",
        "src/shared/mocks/**/*.ts"
      ],
      "rules": {
        "react/rules-of-hooks": "off",
        "eslint/no-console": "off"
      }
    },
    {
      // Client/server boundary (#1445). `src/lib` is server-only; the
      // client-safe half lives in `src/shared`. This is a per-file path rule
      // so the mistake is visible in the editor — the transitive backstop is
      // `src/lib/client-server-boundary.test.ts`. Top-level `import type` is
      // erased at compile time and stays legal; the inline
      // `import { type X }` form is NOT (it leaves a side-effect import), and
      // `typescript/no-import-type-side-effects` above bans it outright.
      //
      // `src/functions/**` is deliberately absent: a server fn's whole job is
      // to reference `src/lib` from inside its handler, which the compiler
      // strips. The boundary test covers it instead, modelling that stripping.
      //
      // Most `!` exceptions below are a directory still mixing server and
      // shared code: delete the line once its client-safe files have moved to
      // `src/shared`. Two are NOT that shape and must not be "migrated":
      //   `!@/lib/storage`   — `routes/r2.$.ts` imports `serve-media` inside a
      //                        `server: { handlers }` block the client build
      //                        prunes. It reaches `#storage`; it can never
      //                        move to `src/shared`.
      //   `!@/lib/workflows` — one `.test.ts` import only. No production
      //                        client file needs it.
      "files": [
        "src/components/**",
        "src/hooks/**",
        "src/routes/**",
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "#db-client",
                "message": "Only db/scoped.ts and auth/config.ts may import #db-client"
              },
              {
                "name": "@/lib/db/scoped",
                "importNames": ["createScopedDb"],
                "message": "createScopedDb only allowed in middleware.ts, workflow/base-workflow.ts, and authorized route handlers. Use context.scopedDb."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/lib/*",
                  "@/lib/**",
                  "!@/lib/ai",
                  "!@/lib/ai/**",
                  "!@/lib/auth",
                  "!@/lib/auth/**",
                  "!@/lib/billing",
                  "!@/lib/billing/**",
                  "!@/lib/compliance",
                  "!@/lib/compliance/**",
                  "!@/lib/image",
                  "!@/lib/image/**",
                  "!@/lib/models",
                  "!@/lib/models/**",
                  "!@/lib/motion",
                  "!@/lib/motion/**",
                  "!@/lib/observability",
                  "!@/lib/observability/**",
                  "!@/lib/prompts",
                  "!@/lib/prompts/**",
                  "!@/lib/realtime",
                  "!@/lib/realtime/**",
                  "!@/lib/scenes",
                  "!@/lib/scenes/**",
                  "!@/lib/sequence-elements",
                  "!@/lib/sequence-elements/**",
                  "!@/lib/sequences",
                  "!@/lib/sequences/**",
                  "!@/lib/sheets",
                  "!@/lib/sheets/**",
                  "!@/lib/shots",
                  "!@/lib/shots/**",
                  "!@/lib/storage",
                  "!@/lib/storage/**",
                  "!@/lib/studio",
                  "!@/lib/studio/**",
                  "!@/lib/style",
                  "!@/lib/style/**",
                  "!@/lib/talent",
                  "!@/lib/talent/**",
                  "!@/lib/workflows",
                  "!@/lib/workflows/**"
                ],
                "allowTypeImports": true,
                "message": "src/lib is server-only and must not ship to the browser. Import the client-safe helper from @/shared (move it there if it is not yet), or make this a type-only import."
              }
            ]
          }
        ]
      }
    },
    {
      // `routes/api/**` are server handlers, not client code.
      "files": ["src/routes/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "#db-client",
                "message": "Only db/scoped.ts and auth/config.ts may import #db-client"
              },
              {
                "name": "@/lib/db/scoped",
                "importNames": ["createScopedDb"],
                "message": "createScopedDb only allowed in middleware.ts, workflow/base-workflow.ts, and authorized route handlers. Use context.scopedDb."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/db/scoped.ts",
        "**/db/client.ts",
        "**/auth/config.ts",
        "**/functions/middleware.ts",
        "**/functions/stripe-webhook-middleware.ts",
        "**/workflow/base-workflow.ts",
        "**/cron/reconcile-all.ts",
        "**/cron/reconcile-fal-billing.ts",
        "**/cron/refresh-fal-pricing.ts",
        "**/ai/fal-pricing-live.ts",
        "**/openrouter/callback.ts",
        "**/lib/test/seed.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
