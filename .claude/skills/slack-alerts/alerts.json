  {
    "name": "Issue spiking · #ops-alerts (#1088)",
    "type": "internal_destination",
    "channel": "#ops-alerts",
    "filters": {
      "source": "internal-events",
      "events": [
        {
          "id": "$error_tracking_issue_spiking",
          "name": "$error_tracking_issue_spiking",
          "type": "events",
          "order": 0,
          "properties": []
        }
      ],
      "filter_test_accounts": false
    },
    "text": "Issue spiking: {event.properties.name}",
    "blocks": [
      {
        "type": "header",
        "text": {
          "type": "plain_text",
          "text": "📈 Issue spiking"
        }
      },
      {
        "type": "section",
        "text": {
          "type": "mrkdwn",
          "text": "```{event.properties.name}: {substring(event.properties.description, 1, 1000)}```"
        }
      },
      {
        "type": "context",
        "elements": [
          {
            "type": "plain_text",
            "text": "Exceptions in last 5 minutes: {event.properties.current_bucket_value} ({event.properties.computed_baseline > 0 ? concat(round(event.properties.current_bucket_value / event.properties.computed_baseline), 'x over baseline') : 'no baseline yet'})"
          },
          {
            "type": "mrkdwn",
            "text": "Project: <{project.url}|{project.name}>"
          },
          {
            "type": "mrkdwn",
            "text": "Alert: <{source.url}|{source.name}>"
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "actions",
        "elements": [
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "View Issue"
            },
            "url": "{project.url}/error_tracking/fingerprint/{encodeURLComponent(event.properties.fingerprint)}?timestamp={event.properties.exception_timestamp}&utm_source=alert&utm_campaign=error_tracking_alert&utm_medium=slack"
          }
        ]
      }
    ],
    "why": "PostHog internal event: internal-events source, no person, so no test-account filter. On the events source it never fires."
  },
  {
    "name": "Exception · #ops-alerts (#1513)",
    "type": "destination",
    "channel": "#ops-alerts",
    "filters": {
      "source": "events",
      "events": [
        {
          "id": "$exception",
          "name": "$exception",
          "type": "events",
          "order": 0,
          "properties": [
            {
              "key": "$exception_types",
              "value": "AbortError",
              "operator": "not_icontains",
              "type": "event"
            },
            {
              "key": "page_translated",
              "value": "true",
              "operator": "is_not",
              "type": "event"
            }
          ]
        }
      ],
      "filter_test_accounts": true
    },
    "text": "Exception: {event.properties.$exception_types} {event.properties.$exception_values}",
    "blocks": [
      {
        "type": "header",
        "text": {
          "type": "plain_text",
          "text": "💥 Exception"
        }
      },
      {
        "type": "section",
        "text": {
          "type": "mrkdwn",
          "text": "```{event.properties.$exception_types}: {substring(event.properties.$exception_values, 1, 1000)}```"
        }
      },
      {
        "type": "context",
        "elements": [
          {
            "type": "mrkdwn",
            "text": "URL: {event.properties.$current_url}"
          },
          {
            "type": "mrkdwn",
            "text": "Person: {person.properties.email ?? event.distinct_id}"
          },
          {
            "type": "mrkdwn",
            "text": "Project: <{project.url}|{project.name}>"
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "actions",
        "elements": [
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "Watch replay"
            },
            "url": "{empty(event.properties.replay_url) ? concat(project.url, '/replay/', event.properties.$session_id) : event.properties.replay_url}"
          },
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "View issue"
            },
            "url": "{project.url}/error_tracking/fingerprint/{encodeURLComponent(event.properties.$exception_fingerprint)}?timestamp={event.timestamp}&utm_source=alert&utm_campaign=exception_alert&utm_medium=slack"
          }
        ]
      }
    ],
    "why": "One message per exception, with the replay cued to when it threw (#1513). AbortError is a cancelled fetch on navigation; page_translated crashes are Chrome translate rewriting the DOM, not ours. replay_url is stamped client-side in src/ui/providers.tsx."
  },
  {
    "name": "Product · sequence_error · #product-alerts (#1088)",
    "type": "destination",
    "channel": "#product-alerts",
    "why": "A sequence or generation workflow failed (base-workflow catch). Staff runs included on purpose; de-duplicated per person and workflow for 30 minutes.",
    "filters": {
      "source": "events",
      "events": [
        {
          "id": "sequence_error",
          "name": "sequence_error",
          "type": "events",
          "order": 0,
          "properties": []
        }
      ],
      "filter_test_accounts": false
    },
    "masking": {
      "ttl": 1800,
      "threshold": null,
      "hash": "{event.distinct_id}{event.properties.workflow}"
    },
    "text": "Sequence error: {person.properties.email ?? event.distinct_id} — {event.properties.workflow}",
    "blocks": [
      {
        "type": "header",
        "text": {
          "type": "plain_text",
          "text": "🚨 Sequence error"
        }
      },
      {
        "type": "section",
        "text": {
          "type": "mrkdwn",
          "text": "*{person.properties.email ?? event.distinct_id}* hit an error in `{event.properties.workflow}`\n```{event.properties.error}```"
        }
      },
      {
        "type": "context",
        "elements": [
          {
            "type": "mrkdwn",
            "text": "Sequence: `{event.properties.sequence_id ?? \"n/a\"}` · Team: `{event.properties.team_id}` · Run: `{event.properties.run_id}`"
          },
          {
            "type": "mrkdwn",
            "text": "Project: <{project.url}|{project.name}>"
          }
        ]
      },
      {
        "type": "actions",
        "elements": [
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "View person in PostHog"
            },
            "url": "{person.url}"
          }
        ]
      }
    ]
  }
]
