{
  "name": "openstory",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "imports": {
    "#env": {
      "workerd": "./src/platform/server/env/cloudflare.ts",
      "default": "./src/platform/server/env/default.ts"
    },
    "#db-client": {
      "workerd": "./src/platform/server/db/client-d1.ts",
      "storybook": "./src/platform/server/db/client-stub.ts",
      "default": "./src/platform/server/db/client-node.ts"
    },
    "#storage": {
      "workerd": "./src/platform/server/storage/storage-cloudflare.ts",
      "default": "./src/platform/server/storage/storage-stub.ts"
    },
    "#flush-scheduler": {
      "workerd": "./src/platform/server/observability/flush-scheduler.cloudflare.ts",
      "default": "./src/platform/server/observability/flush-scheduler.ts"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "tunnel": "bun scripts/dev-hosts.ts",
    "tunnel:provision": "bun scripts/dev-hosts.ts --provision",
    "setup:prd": "bun scripts/setup.ts --prod",
    "setup:deploy": "bun scripts/setup.ts --deploy",
    "setup:stg": "bun scripts/setup.ts --pr-preview",
    "secrets:pull": "doppler secrets download --project openstory --config dev --format env --no-file > .env.local.tmp && mv -f .env.local.tmp .env.local",
    "secrets:dev": "bun run secrets:pull",
    "secrets:push:prd": "bun scripts/push-secrets.ts --config prd --push",
    "secrets:check:prd": "bun scripts/push-secrets.ts --config prd",
    "r2:cors": "bun scripts/set-r2-cors.ts",
    "r2:cors:prd": "bun scripts/set-r2-cors.ts --env=prd",
    "r2:cors:stg": "bun scripts/set-r2-cors.ts --env=stg",
    "r2:cors:dev": "bun scripts/set-r2-cors.ts --env=dev",
    "setup:previews": "bun scripts/generate-style-previews.ts && bun scripts/upload-style-previews-to-r2.ts",
    "setup:system-previews": "bun scripts/generate-system-previews.ts && bun scripts/upload-system-previews-to-r2.ts",
    "styles:sample-videos": "bun scripts/generate-style-sample-videos.ts",
    "styles:sample-videos:upload": "bun scripts/upload-style-sample-videos-to-r2.ts",
    "styles:sample-videos:seed:local": "bun scripts/seed-style-sample-videos.ts --local",
    "styles:sample-videos:seed:d1": "bun scripts/seed-style-sample-videos.ts --d1",
    "styles:sample-videos:seed:sql": "bun scripts/seed-style-sample-videos.ts --sql",
    "agent-harness": "bunx github:tombeckenham/agent-harness",
    "dev": "bun scripts/dev.ts",
    "dev:all": "bun scripts/dev.ts --all",
    "dev:app": "bun run db:migrate:local && bun run db:seed:local && bun run dev:vite",
    "dev:vite": "bun scripts/build-content-collections.ts && vite dev",
    "dev:bunny": "cd containers/video-export && bun install && PORT=8080 bun run dev",
    "stripe:dev": "source .env.local 2>/dev/null; [ -z \"${STRIPE_SECRET_KEY}\" ] && echo 'Skipping Stripe (no STRIPE_SECRET_KEY)' && exit 0; stripe listen --forward-to localhost:${PORT:-3000}/api/billing/webhook --api-key=${STRIPE_SECRET_KEY}",
    "build": "vite build",
    "build:e2e": "CLOUDFLARE_ENV=test VITE_APP_URL=http://localhost:3020 VITE_DISABLE_DEVTOOLS=true vite build",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "dead-code": "bun knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bun playwright test",
    "test:e2e:coverage": "rm -rf e2e/coverage && E2E_COVERAGE=true bun playwright test; E2E_COVERAGE=true PLAYWRIGHT_FULL_PIPELINE=true bun playwright test full-sequence generation tests/editing-; bun e2e/coverage-report.ts",
    "test:e2e:ui": "bun playwright test --ui",
    "test:e2e:full": "PLAYWRIGHT_FULL_PIPELINE=true bun playwright test full-sequence generation tests/editing-",
    "test:e2e:full:built": "PLAYWRIGHT_FULL_PIPELINE=true bun run build:e2e && bun run prepare:e2e-built && E2E_BUILT=true PLAYWRIGHT_FULL_PIPELINE=true bun playwright test full-sequence generation tests/editing-",
    "test:e2e:record": "E2E_RECORD=1 bun scripts/e2e-record.ts",
    "test:e2e:full:record": "E2E_RECORD=1 PLAYWRIGHT_FULL_PIPELINE=true bun scripts/e2e-record.ts full-sequence generation tests/editing-",
    "prepare:e2e-built": "mkdir -p .wrangler/deploy && printf '%s' '{\"configPath\":\"../../dist/server/wrangler.json\",\"auxiliaryWorkers\":[]}' > .wrangler/deploy/config.json",
    "test:e2e:setup": "bun run db:migrate:test && bun scripts/seed.ts --test",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.d1.ts",
    "auth:generate": "bun x auth@latest generate --config src/platform/server/auth/cli-config.ts",
    "db:check": "bun drizzle-kit check --config=drizzle.config.d1.ts",
    "db:migrate:local": "bun scripts/migrate-local-d1.ts",
    "db:migrate:test": "bun scripts/migrate-local-d1.ts --test",
    "db:migrate:prd": "bun scripts/flatten-migrations.ts && wrangler d1 migrations apply DB --env=production --remote",
    "explorer": "open http://localhost:3000/cdn-cgi/explorer/",
    "db:studio:local": "bun drizzle-kit studio --config=drizzle.config.local.ts",
    "db:studio:d1": "bun drizzle-kit studio --config=drizzle.config.d1.ts",
    "db:seed:local": "bun scripts/seed.ts --local",
    "db:fork:local": "bun scripts/db-worktree.ts --fork",
    "db:promote:local": "bun scripts/db-worktree.ts --promote",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "motion:codegen": "bun scripts/pull-motion-schemas.ts",
    "models:check": "bun scripts/check-model-updates.ts",
    "cf:typegen": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy:prd": "bun run cf:typegen && CLOUDFLARE_ENV=production bun run build && bun run db:migrate:prd && wrangler deploy --env=production",
    "deploy": "bun scripts/flatten-migrations.ts && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:production": "bun scripts/flatten-migrations.ts && wrangler d1 migrations apply DB --env=production --remote && wrangler deploy",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:publish": "changeset publish",
    "changeset:check": "changeset status"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "1.7.18",
    "@better-auth/core": "1.7.18",
