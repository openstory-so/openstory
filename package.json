{
  "name": "openstory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#env": {
      "workerd": "./src/lib/env/cloudflare.ts",
      "default": "./src/lib/env/default.ts"
    },
    "#db-client": {
      "workerd": "./src/lib/db/client-d1.ts",
      "storybook": "./src/lib/db/client-stub.ts",
      "default": "./src/lib/db/client-node.ts"
    },
    "#storage": {
      "workerd": "./src/lib/storage/storage-cloudflare.ts",
      "default": "./src/lib/storage/storage-stub.ts"
    },
    "#flush-scheduler": {
      "workerd": "./src/lib/observability/flush-scheduler.cloudflare.ts",
      "default": "./src/lib/observability/flush-scheduler.ts"
    },
    "#actions/*": {
      "storybook": "./src/app/actions/*/index.mock.ts",
      "default": "./src/app/actions/*/index.ts"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "setup:prd": "bun scripts/setup.ts --prod",
    "setup:deploy": "bun scripts/setup.ts --deploy",
    "setup:stg": "bun scripts/setup.ts --pr-preview",
    "secrets:pull": "doppler secrets download --project openstory --config dev --format env --no-file > .env.local.tmp && mv -f .env.local.tmp .env.local",
    "secrets:dev": "bun run secrets:pull",
    "secrets:push:prd": "bun scripts/push-secrets.ts --config prd --push",
    "secrets:check:prd": "bun scripts/push-secrets.ts --config prd",
    "r2:cors": "bun scripts/set-r2-cors.ts",
    "r2:cors:prd": "bun scripts/set-r2-cors.ts --env=prd",
    "r2:cors:stg": "bun scripts/set-r2-cors.ts --env=stg",
    "r2:cors:dev": "bun scripts/set-r2-cors.ts --env=dev",
    "setup:previews": "bun scripts/generate-style-previews.ts && bun scripts/upload-style-previews-to-r2.ts",
    "setup:system-previews": "bun scripts/generate-system-previews.ts && bun scripts/upload-system-previews-to-r2.ts",
    "styles:sample-videos": "bun scripts/generate-style-sample-videos.ts",
    "styles:sample-videos:upload": "bun scripts/upload-style-sample-videos-to-r2.ts",
    "styles:sample-videos:seed:local": "bun scripts/seed-style-sample-videos.ts --local",
    "styles:sample-videos:seed:d1": "bun scripts/seed-style-sample-videos.ts --d1",
    "styles:sample-videos:seed:sql": "bun scripts/seed-style-sample-videos.ts --sql",
    "agent-harness": "bunx github:tombeckenham/agent-harness",
    "dev": "bun scripts/ensure-env.ts && bun run dev:app",
    "dev:all": "bun scripts/ensure-env.ts && CLOUDFLARE_INCLUDE_PROCESS_ENV=true VIDEO_EXPORT_DEV_URL=http://localhost:8080 bun run --parallel dev:app stripe:dev dev:bunny",
    "dev:app": "bun --sequential db:migrate:local db:seed:local dev:vite",
    "dev:vite": "bun scripts/build-content-collections.ts && vite dev",
    "dev:bunny": "cd containers/video-export && bun install && bun run dev",
    "stripe:dev": "source .env.local 2>/dev/null; [ -z \"${STRIPE_SECRET_KEY}\" ] && echo 'Skipping Stripe (no STRIPE_SECRET_KEY)' && exit 0; stripe listen --forward-to localhost:3000/api/billing/webhook --api-key=${STRIPE_SECRET_KEY}",
    "build": "vite build",
    "build:e2e": "CLOUDFLARE_ENV=test VITE_APP_URL=http://localhost:3001 VITE_DISABLE_DEVTOOLS=true vite build",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "dead-code": "bun knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bun playwright test",
    "test:e2e:ui": "bun playwright test --ui",
    "test:e2e:full": "PLAYWRIGHT_FULL_PIPELINE=true bun playwright test full-sequence",
    "test:e2e:full:built": "PLAYWRIGHT_FULL_PIPELINE=true bun run build:e2e && bun run prepare:e2e-built && E2E_BUILT=true PLAYWRIGHT_FULL_PIPELINE=true bun playwright test full-sequence",
    "test:e2e:record": "E2E_RECORD=1 bun playwright test",
    "test:e2e:full:record": "E2E_RECORD=1 PLAYWRIGHT_FULL_PIPELINE=true bun playwright test full-sequence",
    "prepare:e2e-built": "mkdir -p .wrangler/deploy && printf '%s' '{\"configPath\":\"../../dist/server/wrangler.json\",\"auxiliaryWorkers\":[]}' > .wrangler/deploy/config.json",
    "test:e2e:setup": "bun run db:migrate:test && bun scripts/seed.ts --test",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.d1.ts",
    "auth:generate": "bun x auth@1.7.2 generate --config src/lib/auth/cli-config.ts",
    "db:check": "bun drizzle-kit check --config=drizzle.config.d1.ts",
    "db:migrate:local": "bun scripts/migrate-local-d1.ts",
    "db:migrate:test": "bun scripts/migrate-local-d1.ts --test",
    "db:migrate:prd": "bun scripts/flatten-migrations.ts && wrangler d1 migrations apply DB --env=production --remote",
    "explorer": "open http://localhost:3000/cdn-cgi/explorer/",
    "db:studio:local": "bun drizzle-kit studio --config=drizzle.config.local.ts",
    "db:studio:d1": "bun drizzle-kit studio --config=drizzle.config.d1.ts",
    "db:seed:local": "bun scripts/seed.ts --local",
    "db:fork:local": "bun scripts/db-worktree.ts --fork",
    "db:promote:local": "bun scripts/db-worktree.ts --promote",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "motion:codegen": "bun scripts/pull-motion-schemas.ts",
    "models:check": "bun scripts/check-model-updates.ts",
    "cf:typegen": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy:prd": "bun run cf:typegen && CLOUDFLARE_ENV=production bun run build && bun run db:migrate:prd && wrangler deploy --env=production",
    "deploy": "bun scripts/flatten-migrations.ts && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:production": "bun scripts/flatten-migrations.ts && wrangler d1 migrations apply DB --env=production --remote && wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/containers": "^0.3.7",
    "@content-collections/core": "0.15.2",
    "@content-collections/vite": "0.3.0",
    "@fal-ai/client": "^1.10.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.3.2",
    "@openrouter/sdk": "0.13.20",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@posthog/react": "^1.10.5",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/ai": "^0.52.1",
    "@tanstack/ai-byteplus": "^0.3.3",
    "@tanstack/ai-fal": "^0.13.2",
    "@tanstack/ai-gemini": "^0.26.5",
    "@tanstack/ai-grok": "^0.18.3",
    "@tanstack/ai-openrouter": "^0.19.4",
    "@tanstack/highlight": "0.0.10",
    "@tanstack/markdown": "0.0.13",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/zod-adapter": "^1.167.0",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@unpic/react": "^1.0.2",
    "@videojs/media": "10.0.0-beta.32",
    "@videojs/react": "^10.0.0-beta.26",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.37.0",
    "mediabunny": "^1.55.4",
    "mermaid": "^11.17.2",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "posthog-js": "^1.422.5",
    "posthog-node": "^5.51.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@copilotkit/aimock": "^1.39.0",
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@logtape/pretty": "^2.3.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-ai-devtools": "^0.2.71",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-utils": "^1.162.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^6.0.0",
    "json5": "^2.2.3",
    "jsonc-parser": "3.3.1",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.62.1",
    "shadcn": "^4.19.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@better-auth/core": "1.7.2",
    "@tanstack/ai-devtools-core": "0.5.5",
    "@tiptap/core": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "prosemirror-model": "1.25.11",
    "prosemirror-view": "1.42.2",
    "qs": "6.15.2",
    "ws": "^8.21.0"
  },
  "engines": {
    "bun": ">=1.3.9 < 2",
    "node": ">=24 < 25"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Signs session cookies. Generate a random string with `openssl rand -hex 32`."
      },
      "API_KEY_ENCRYPTION_KEY": {
        "description": "Encrypts AI keys that teams add in-app (bring-your-own-key). Generate with `openssl rand -hex 32`."
      },
      "EMAIL_FROM": {
        "description": "Sender address for sign-in code emails, e.g. `noreply@yourdomain.com`. Required for sign-in: authentication is passwordless (emailed one-time codes), so without it nobody can create an account on this deployment. The domain must be onboarded in [Email Service > Email Sending](https://dash.cloudflare.com/?to=/:account/email-service/sending) — onboarding sets up SPF/DKIM/DMARC for you."
      },
      "DB": {
        "description": "D1 database for app data. Created automatically — the deploy command applies migrations on every deploy, and starter templates seed themselves on first request."
      },
      "R2_STORAGE_BUCKET": {
        "description": "R2 bucket for generated media (images, video, audio). Created automatically."
      },
      "R2_PUBLIC_ASSETS_BUCKET": {
        "description": "R2 bucket for public marketing/template assets. Created automatically."
      }
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
