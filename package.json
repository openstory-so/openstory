    "@react-email/components": "^1.0.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/ai": "^1.4.0",
    "@tanstack/ai-byteplus": "^1.1.1",
    "@tanstack/ai-client": "1.1.0",
    "@tanstack/ai-durable-stream": "1.0.0",
    "@tanstack/ai-elevenlabs": "^1.1.1",
    "@tanstack/ai-fal": "^1.1.1",
    "@tanstack/ai-gemini": "^1.2.1",
    "@tanstack/ai-grok": "^1.1.1",
    "@tanstack/ai-mcp": "^1.2.0",
    "@tanstack/ai-openai": "^1.1.1",
    "@tanstack/ai-openrouter": "^1.1.2",
    "@tanstack/ai-persistence": "1.0.1",
    "@tanstack/ai-react": "1.0.2",
    "@tanstack/highlight": "1.2.11",
    "@tanstack/markdown": "1.2.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-virtual": "^3.14.26",
